{
  "name": "bs58ify",
  "version": "0.1.2",
  "description": "A CLI for converting between Base58 strings and JSON byte arrays.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChiefWoods/bs58ify.git"
  },
  "homepage": "https://github.com/ChiefWoods/bs58ify#readme",
  "bugs": {
    "url": "https://github.com/ChiefWoods/bs58ify/issues"
  },
  "type": "module",
  "bin": {
    "bs58ify": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rolldown src/cli.ts --config rolldown.config.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt --check",
    "fmt:fix": "oxfmt --write",
    "check": "bun run typecheck && bun run lint && bun run fmt && bun test",
    "prepublishOnly": "bun run check && bun run build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "bs58": "^6.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "oxfmt": "^0.55.0",
    "oxlint": "^1.70.0",
    "rolldown": "^1.1.2"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "commander": "^15.0.0"
  },
  "keywords": [
    "bs58",
    "base58",
    "cli",
    "command-line",
    "utility"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  }
}
